# Copy to .env and fill in. .env is loaded automatically on startup and is not committed.

# Secret key for signing sessions and CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a temporary key is generated and everyone is logged out on restart.
SECRET_KEY=

# SQLAlchemy database URL. A relative SQLite path is resolved against the instance/ folder.
DATABASE_URL=sqlite:///blog.db

# 1 enables the debugger and auto-reload. Never enable it on a publicly reachable server.
FLASK_DEBUG=0
